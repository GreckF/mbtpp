// Importing MoonBit packages (listed in moon.pkg.json next to this file).
// Imported functions are only type checked: `mbtpp check` accepts this
// program, while running it stops at the first call of an imported function.

fn distance(x : Double, y : Double) -> Double {
  @math.hypot(x, y)
}

fn[T : Show] show_or(r : Result[T, Error], default : String) -> String {
  match r {
    Ok(x) => x.to_string()
    Err(_) => default
  }
}

// a function that may raise, called with an optional labelled argument
fn parse_hex(s : String) -> Int raise {
  @conv.parse_int(s, base=16)
}

fn main {
  println(distance(3.0, 4.0))
  println(show_or(try? parse_hex("ff"), "not a number"))
}
