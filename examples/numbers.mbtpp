// Numeric types and maps.

fn big(n : Int64) -> Int64 {
  n * 1000000L * 1000000L
}

fn low_byte(x : UInt) -> UInt {
  x & 0xFFU
}

fn sum_bytes(bs : Array[Byte]) -> Int {
  let mut s = 0
  for b in bs {
    s = s + b.to_int()
  }
  s
}

fn size(n : Int64) -> String {
  match n {
    0L => "zero"
    1L..=9L => "small"
    _ => "big"
  }
}

fn count(words : Array[String]) -> Map[String, Int] {
  let m : Map[String, Int] = {}
  for w in words {
    match m.get(w) {
      Some(n) => m[w] = n + 1
      None => m[w] = 1
    }
  }
  m
}

fn main {
  println(big(7L))
  println(low_byte(0x1234U))
  println(18446744073709551615UL)
  println(sum_bytes([b'a', b'\x01', (2).to_byte()]))
  println(size(0L) + " " + size(5L) + " " + size(-3L))
  println((3.0F / 2.0F).to_double())
  println(9223372036854775807L + 1L)
  let ages = { "ann": 31, "bob": 27 }
  ages["cy"] = 40
  println(ages)
  println(ages["bob"])
  for name, age in ages {
    println(name + " " + age.to_string())
  }
  println(count(["x", "y", "x"]))
}
