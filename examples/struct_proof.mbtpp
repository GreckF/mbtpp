struct Vec[T, n : Nat] {
  to_array : Array[T]
  length_to_array : to_array.size() === n
}

fn[T] Vec::from_array(xs : Array[T]) -> Vec[T, xs.size()] {
  { to_array: xs, length_to_array: Refl }
}

fn[T, n : Nat] Vec::get(self : Vec[T, n], i : Int) -> T {
  self.to_array[i]
}

lemma plus_zero : forall n : Nat, plus(n, 0) === n = proof {
  intros n
  destruct n
  rfl
  rewrite plus_zero(n_0)
  rfl
}

lemma plus_succ(n : Nat, m : Nat) -> plus(n, S(m)) === S(plus(n, m)) {
  match n {
    Z => Refl
    S(k) => Id::cong(S, plus_succ(k, m))
  }
}

fn main {
  let v = Vec::from_array([1, 2, 3])
  println(v.get(1))
  println(v.to_array)
}
