///|
/// Output files. The generated code mirrors the sources: the definitions of
/// `x.mbtpp` go to `x.mbt` (one file per source file, even if it is empty),
/// with the constructors of its datatypes added to the `Value` extensible
/// enum of the runtime. Definitions of the prelude go to `mbtpp_prelude.mbt`,
/// glue for imported MoonBit packages to `mbtpp_imports.mbt`, and the runtime
/// is `mbtpp_runtime.mbt`.
let prelude_file : String = "mbtpp_prelude.mbt"

///|
let imports_file : String = "mbtpp_imports.mbt"

///|
let runtime_file : String = "mbtpp_runtime.mbt"

///|
/// The output file of a source file: `src/main/a.mbtpp` -> `a.mbt`.
fn out_file(src : String) -> String {
  if src == "<prelude>" {
    return prelude_file
  }
  let mut base = src
  for sep in ["/", "\\"] {
    match base.rev_find(sep) {
      Some(k) => base = base.unsafe_substring(start=k + 1, end=base.length())
      None => ()
    }
  }
  if base.has_suffix(".mbtpp") {
    base = base.unsafe_substring(start=0, end=base.length() - 6)
  }
  base + ".mbt"
}

///|
/// The output file of the definition of a global.
fn Gen::file_of(self : Gen, name : String) -> String {
  match @tt.global_files.get(name) {
    Some(f) => out_file(f)
    None =>
      // `f$default$x`, the default of a labelled parameter of `f`
      match name.find("$default$") {
        Some(k) => self.file_of(name.unsafe_substring(start=0, end=k))
        None => imports_file
      }
  }
}

///|
fn Gen::buffer(self : Gen, file : String) -> StringBuilder {
  match self.files.get(file) {
    Some(b) => b
    None => {
      let b = StringBuilder::new()
      self.files.set(file, b)
      b
    }
  }
}

///|
/// Write to the file of the global being emitted.
fn Gen::write(self : Gen, code : String) -> Unit {
  self.buffer(self.cur_file).write_string(code)
}

///|
fn Gen::write_to(self : Gen, file : String, code : String) -> Unit {
  self.buffer(file).write_string(code)
}

///|
/// The constructors of the datatypes of `file`, as variants of `Value`, and
/// their registration for the generic functions of the runtime.
fn Gen::value_ext(self : Gen, file : String) -> String {
  let cs = self.ctor_order.filter(c => self.file_of(c) == file)
  if cs.length() == 0 {
    return ""
  }
  let decl = StringBuilder::new()
  let dec = StringBuilder::new()
  decl.write_string("\n///|\nextenum Value += {\n")
  dec.write_string("\n///|\nfn init {\n  con_decoders.push(v => match v {\n")
  for c in cs {
    let (id, n) = self.ctors.get(c).unwrap()
    let xs : Array[String] = []
    for k = 0; k < n; k = k + 1 {
      xs.push("a" + k.to_string())
    }
    decl.write_string(
      "  /// " +
      c +
      "\n  " +
      id +
      (if n == 0 { "" } else { "(" + xs.map(_ => "Value").join(", ") + ")" }) +
      "\n",
    )
    let pat = if n == 0 { id } else { id + "(" + xs.join(", ") + ")" }
    dec.write_string(
      "    " + pat + " => Some((" + c.escape() + ", [" + xs.join(", ") + "]))\n",
    )
  }
  decl.write_string("}\n")
  dec.write_string("    _ => None\n  })\n}\n")
  decl.to_string() + dec.to_string()
}

///|
/// The foreign MoonBit types of the program, as variants of `Foreign`.
fn Gen::foreign_ext(self : Gen) -> String {
  if self.foreign_order.length() == 0 {
    return ""
  }
  let b = StringBuilder::new()
  b.write_string("\n///|\nextenum Foreign += {\n")
  for ty in self.foreign_order {
    b.write_string("  " + self.foreign.get(ty).unwrap() + "(" + ty + ")\n")
  }
  b.write_string("}\n")
  b.to_string()
}

///|
/// The generated files: one per source file (in order), then the prelude
/// and the imports if they have code, then the runtime.
fn Gen::output_files(self : Gen) -> Array[(String, String)] raise CodegenError {
  let srcs : Map[String, String] = {}
  let order : Array[String] = []
  for f in @tt.source_files {
    let o = out_file(f)
    if [prelude_file, imports_file, runtime_file].contains(o) {
      raise CodegenError(
        "the file " + f + " would be compiled to " + o + ", which moonpp uses",
      )
    }
    srcs.set(o, f)
    order.push(o)
  }
  for o in [prelude_file, imports_file] {
    if self.files.contains(o) ||
      self.ctor_order.iter().any(c => self.file_of(c) == o) ||
      (o == imports_file && self.foreign_order.length() > 0) {
      srcs.set(o, if o == prelude_file { "the prelude" } else { "imports" })
      order.push(o)
    }
  }
  order.map(o => {
    let body = self.files.get(o).map(b => b.to_string()).unwrap_or("")
    let code = "// Generated by moonpp from " +
      srcs.get(o).unwrap() +
      ". Do not edit.\n" +
      self.value_ext(o) +
      (if o == imports_file { self.foreign_ext() } else { "" }) +
      body
    (o, code)
  })
}
